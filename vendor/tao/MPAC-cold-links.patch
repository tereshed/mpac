+// Startup URL contexts use the same safe delivery path as warm links.
+pub(crate) unsafe fn emit_opened_from_url_contexts(contexts: &NSSet<UIOpenURLContext>) {
+  let urls = contexts.iter().filter_map(|ctx| {
+    ctx.URL().absoluteString().and_then(|value| value.to_string().parse().ok())
+  }).collect::<Vec<url::Url>>();
+  if !urls.is_empty() {
+    app_state::handle_nonuser_event(EventWrapper::StaticEvent(Event::Opened { urls }));
+  }
+}
+
+pub(crate) unsafe fn emit_opened_from_user_activity(activity: &NSUserActivity) {
+  if let Some(url) = activity.webpageURL().and_then(|url| url.absoluteString())
+    .and_then(|url| url.to_string().parse::<url::Url>().ok())
+  {
+    app_state::handle_nonuser_event(EventWrapper::StaticEvent(Event::Opened { urls: vec![url] }));
+  }
+}
+
+pub(crate) unsafe fn emit_opened_from_user_activities(activities: &NSSet<NSUserActivity>) {
+  for activity in activities.iter() {
+    emit_opened_from_user_activity(&activity);
+  }
+}
